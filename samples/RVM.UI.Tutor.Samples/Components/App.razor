<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RVM.UI.Tutor.Samples.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // A mesma tela nos dois modos: /wasm/... sobe em WebAssembly, o resto em Server (Fase 2 valida o WASM).
    private IComponentRenderMode PageRenderMode =>
        HttpContext.Request.Path.StartsWithSegments("/wasm") ? InteractiveWebAssembly : InteractiveServer;
}
